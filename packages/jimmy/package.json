{
  "name": "openryoko",
  "version": "2026.10.22",
  "description": "OpenRyoko — Slackで空気を読んで働くAIアシスタント・ゲートウェイ（Jinnベース、Claude Code/Codex/Gemini CLI対応）",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "bin": {
    "ryoko": "./dist/bin/jimmy.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/",
    "template/",
    "scripts/"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -r assets dist/assets && cp -r ../web/out dist/web",
    "postinstall": "node scripts/fix-prebuild-permissions.mjs",
    "dev": "tsc && (tsc --watch &) && node --watch-path=dist dist/bin/jimmy.js start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@slack/bolt": "^4.7.3",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "busboy": "^1.6.0",
    "chokidar": "^4.0.3",
    "classic-level": "^2.0.0",
    "commander": "^13.1.0",
    "discord.js": "^14.27.0",
    "js-yaml": "^4.3.2",
    "node-cron": "4.6.0",
    "node-pty": "^1.1.0",
    "node-telegram-bot-api": "2.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.5",
    "uuid": "^11.1.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@openryoko/web": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
